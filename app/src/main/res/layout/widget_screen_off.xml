<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget_card"
    android:gravity="center"
    android:orientation="horizontal"
    android:padding="8dp">

    <LinearLayout
        android:id="@+id/widget_btn_lock"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/widget_img_lock"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_widget_btn_lock"
            android:contentDescription="Lock Screen"
            android:padding="10dp"
            android:src="@drawable/ic_widget_lock" />

        <TextView
            android:id="@+id/widget_txt_lock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Lock"
            android:textColor="#F8FAFC"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_btn_power"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/widget_img_power"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_widget_btn_power"
            android:contentDescription="Power Menu"
            android:padding="10dp"
            android:src="@drawable/ic_widget_power" />

        <TextView
            android:id="@+id/widget_txt_power"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Power"
            android:textColor="#CBD5E1"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
